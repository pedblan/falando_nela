{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falando-nela.local/schemas/operation-manifest-1.0.0.json",
  "title": "Manifest operacional do Falando Nela",
  "description": "Contrato D06 para separar proveniência técnica, relatório humano e diagnóstico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "module",
    "operation_id",
    "analysis_run_id",
    "snapshot_id",
    "spec_ref",
    "spec_version",
    "code_commit",
    "execution_status",
    "scientific_gate",
    "started_at",
    "finished_at",
    "inputs",
    "outputs",
    "config_ref",
    "config_hash",
    "counts",
    "report_ref",
    "log_ref",
    "warnings_ref",
    "errors_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "analysis_run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "spec_ref": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "execution_status": {
      "enum": [
        "not_started",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "scientific_gate": {
      "enum": [
        "not_applicable",
        "not_evaluated",
        "needs_review",
        "approved",
        "rejected"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "config_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "config_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "report_ref": {
      "const": "relatorio.md"
    },
    "log_ref": {
      "const": "logs/execution.jsonl"
    },
    "warnings_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "errors_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "uri",
        "format",
        "size_bytes",
        "sha256",
        "rows"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
